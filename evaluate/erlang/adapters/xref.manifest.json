{
  "schema_version": 1,
  "kind": "erlang_adapter_manifest",
  "adapter": "xref",
  "target": {
    "name": "server_flexible",
    "scope": "repository_root"
  },
  "activation": {
    "mode": "always",
    "required": true,
    "fallback": "none"
  },
  "contract": {
    "role": "module-level dependency and undefined-call evidence",
    "evidence_kinds": ["DEPENDS_ON"],
    "query_kinds": ["module_dependencies"]
  },
  "invocation": {
    "mode": "argv",
    "argv": ["rebar3", "xref"],
    "executable": "rebar3",
    "command_allowlist": {
      "executables": ["rebar3"],
      "subcommands": ["xref"],
      "flags": [],
      "reject_shell_metacharacters": true
    },
    "shell": false,
    "cwd": "repository_root",
    "stdin": "devnull",
    "environment_allowlist": ["PATH", "HOME", "LANG", "LC_ALL", "ERL_LIBS", "REBAR_COLOR", "REBAR_CACHE_DIR"]
  },
  "preparation": {
    "argv": ["./xserver.sh", "compile"],
    "cwd": "repository_root",
    "required": true,
    "reason": "server_flexible generated headers and release artifacts must be current before xref"
  },
  "timeout": {
    "default_seconds": 15,
    "max_seconds": 900,
    "version_probe_seconds": 2,
    "on_exceeded": "status_timeout_and_omit_xref_evidence",
    "return_code": 124
  },
  "failure": {
    "default_status": "failed",
    "fallback": "none",
    "events": {
      "missing_tool": {
        "status": "failed",
        "diagnostic_codes": ["xref_unavailable"],
        "action": "block_preflight",
        "fallback": "none"
      },
      "nonzero_exit": {
        "status": "degraded",
        "diagnostic_codes": ["xref_diagnostics", "xref_undefined_call", "xref_warning"],
        "action": "preserve_parseable_xref_diagnostics_when_analysis_completed; block only on execution failure",
        "fallback": "none"
      },
      "timeout": {
        "status": "timeout",
        "diagnostic_codes": ["xref_timeout"],
        "action": "omit_xref_evidence",
        "fallback": "none"
      },
      "malformed_output": {
        "status": "malformed",
        "diagnostic_codes": ["xref_malformed_output", "xref_no_evidence"],
        "action": "discard_xref_evidence",
        "fallback": "none"
      }
    }
  },
  "output": {
    "format": "text_or_json",
    "stream": "stdout_and_stderr",
    "max_bytes": 2000000,
    "malformed": {
      "status": "malformed",
      "diagnostic_codes": ["xref_malformed_output", "xref_no_evidence"],
      "action": "discard_xref_evidence",
        "fallback": "none"
    }
  },
  "provenance": {
    "source": "xref",
    "tool": "rebar3",
    "required_fields": [
      "source",
      "tool",
      "tool_version",
      "otp_version",
      "repository",
      "source_revision",
      "generated_data_revision",
      "configuration_digest",
      "query_kind",
      "query_targets",
      "status",
      "analysis_key",
      "command",
      "duration_seconds",
      "cache_state"
    ],
    "command_recorded": true,
    "raw_output_recorded": true
  },
  "cache": {
    "enabled": true,
    "key_fields": [
      "repository",
      "source_revision",
      "generated_data_revision",
      "configuration_digest",
      "tool",
      "tool_version",
      "otp_version",
      "query_kind",
      "query_targets"
    ],
    "key_algorithm": "sha256(canonical_json(key_fields))",
    "path_template": "{cache_dir}/{analysis_key}.json",
    "stale_policy": "reject_revision_mismatch",
    "atomic_write": true
  },
  "sandbox": {
    "cwd": "repository_root",
    "read_paths": ["target_source", "target_dependencies", "target_build"],
    "write_paths": ["cache_dir", "adapter_workspace"],
    "network": "deny",
    "project_code_execution": "rebar3_task_may_load_plugins",
    "config_scripts": "must_be_disabled_or_reviewed_before_enablement",
    "outside_workspace": "deny",
    "allow_target_writes": false,
    "known_side_effects": ["rebar3 may populate _build or plugin caches"]
  },
  "enforcement": {
    "runtime_policy_enforced": true,
    "status": "enforced"
  }
}
